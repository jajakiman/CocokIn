# Local Database and Prisma Migrations
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Custom email/password session
SESSION_SECRET="your-32-char-random-secret"

# Google OAuth
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
APP_URL="http://localhost:3000"

# Transactional Email (Resend free tier)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="CocokIn <no-reply@your-verified-domain.com>"
    
# Pusher Channels (Realtime Chat)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap1"
