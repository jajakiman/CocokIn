generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TALENT
  BUSINESS
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum IdentityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConsentPurpose {
  TERMS_ACCEPTANCE
  PRIVACY_PROCESSING
  PUBLIC_PORTFOLIO
  TESTIMONIAL
  DEMO_DATA_USE
  RESEARCH_PARTICIPATION
  MARKETING_COMMUNICATION
  PROJECT_COMMUNICATION_RETENTION
  VOICE_NOTE_PROCESSING
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum ConsentSource {
  REGISTRATION
  ACCOUNT_SETTINGS
  PROJECT_FLOW
  SEEDED_DEMO
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  TALENT_SELECTED
  AGREEMENT_CONFIRMED
  FUNDING_PENDING
  FUNDED
  IN_PROGRESS
  STAGING_REVIEW
  PRODUCTION_DEPLOYMENT
  HANDOVER_PENDING
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ProjectApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConversationStatus {
  PENDING
  ACTIVE
  SUPPORT_ACTIVE
  READ_ONLY
  REOPEN_REQUESTED
}

enum ChatMessageType {
  TEXT
  SYSTEM
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role       @default(TALENT)
  status         UserStatus @default(ACTIVE)
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  identityTokens            IdentityToken[]
  consentRecords            ConsentRecord[]
  talentProfile             TalentProfile?
  businessProfile           BusinessProfile?
  ownedProjects             Project[]                 @relation("BusinessProjects")
  projectApplications       ProjectApplication[]      @relation("TalentApplications")
  selectedProjects          Project[]                 @relation("SelectedTalentProjects")
  selectedProjectAgreements ProjectAgreement[]        @relation("SelectedTalentAgreements")
  conversationMemberships   ConversationParticipant[]
  sentMessages              ChatMessage[]
  messageReceipts           MessageReceipt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  sessionVersion Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model IdentityToken {
  id         String            @id @default(cuid())
  userId     String?
  identifier String
  token      String            @unique
  type       IdentityTokenType
  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@index([identifier, type, expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String
  purpose       ConsentPurpose
  status        ConsentStatus
  source        ConsentSource
  policyVersion String
  occurredAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, createdAt])
}

model TalentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String        @id @default(cuid())
  businessId       String
  title            String
  status           ProjectStatus @default(DRAFT)
  selectedTalentId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business       User                 @relation("BusinessProjects", fields: [businessId], references: [id], onDelete: Restrict)
  selectedTalent User?                @relation("SelectedTalentProjects", fields: [selectedTalentId], references: [id], onDelete: Restrict)
  applications   ProjectApplication[]
  agreement      ProjectAgreement?
  conversation   ProjectConversation?

  @@index([businessId, status])
  @@index([selectedTalentId])
}

model ProjectApplication {
  id         String                   @id @default(cuid())
  projectId  String
  talentId   String
  status     ProjectApplicationStatus @default(PENDING)
  motivation String?                  @db.Text
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  talent  User    @relation("TalentApplications", fields: [talentId], references: [id], onDelete: Restrict)

  @@unique([projectId, talentId])
  @@index([talentId, status])
}

model ProjectAgreement {
  id                 String    @id @default(cuid())
  projectId          String    @unique
  selectedTalentId   String
  businessAcceptedAt DateTime?
  talentAcceptedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project        Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  selectedTalent User    @relation("SelectedTalentAgreements", fields: [selectedTalentId], references: [id], onDelete: Restrict)

  @@index([selectedTalentId])
}

model ProjectConversation {
  id                 String             @id @default(cuid())
  projectId          String             @unique
  status             ConversationStatus @default(PENDING)
  nextSequenceNumber Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     ChatMessage[]
}

model ConversationParticipant {
  id               String   @id @default(cuid())
  conversationId   String
  userId           String
  joinedAt         DateTime @default(now())
  lastReadSequence Int      @default(0)

  conversation ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id              String          @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String
  sequenceNumber  Int
  type            ChatMessageType @default(TEXT)
  content         String          @db.Text
  createdAt       DateTime        @default(now())

  conversation ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  receipts     MessageReceipt[]

  @@unique([conversationId, sequenceNumber])
  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}
